# Copy to .env for local development. Never commit real values.
# Variables are grouped by the process that reads them; each process only
# receives its own group in production (see docker/compose.prod.yml, step 15).

# ---------- shared ----------
NODE_ENV=development
LOG_LEVEL=info

# ---------- migrations (schema owner; CI / deploy only, never at runtime) ----------
# Local: the docker/compose.dev.yml database.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# ---------- api ----------
API_HOST=0.0.0.0
API_PORT=4000
# Runtime role noctiv_api (RLS enforced). Password is set outside migrations:
#   alter role noctiv_api with login password '...';
# Supabase session pooler format: postgres://noctiv_api.<project-ref>:<pw>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
API_DATABASE_URL=postgres://noctiv_api:change-me@localhost:54322/postgres

# ---------- worker ----------
# Runtime role noctiv_worker (RLS enforced).
WORKER_DATABASE_URL=postgres://noctiv_worker:change-me@localhost:54322/postgres

# ---------- tests ----------
# Optional: reuse a running database instead of starting a container.
# Must be a disposable database; tests create and drop data freely.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# ---------- LLM (worker; step 4) ----------
# Provider is chosen automatically:
#   GCP_PROJECT_ID + GOOGLE_APPLICATION_CREDENTIALS present -> Vertex AI (paid, EU, no training)
#   otherwise GEMINI_API_KEY present                        -> Google AI Studio (FREE TIER:
#       data may be used for training; only mailboxes flagged is_test_mailbox are processed)
# LLM_PROVIDER=vertex|google_ai_studio|fake forces a choice (fake: never in production).
# GEMINI_API_KEY=
# GCP_PROJECT_ID=
# GCP_LOCATION=europe-west4          # EU regions only; others are refused at startup
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-service-account.json
# Model overrides (defaults pinned in packages/llm/src/models.ts):
# LLM_MODEL_FAST=gemini-3.5-flash-lite
# LLM_MODEL_QUALITY=gemini-3.8-flash
# EMBED_MODEL=gemini-embedding-001   # output is always 768 dims (= kb_chunks.embedding)
# LLM_TIMEOUT_MS=60000
# Never set GOOGLE_GEMINI_BASE_URL / GOOGLE_VERTEX_BASE_URL: startup is refused if they are.

# ---------- Knowledge base storage (worker; step 5) ----------
# Local: the Storage container in docker/compose.dev.yml; token from
#   node packages/kb/scripts/local-storage-token.ts
# Cloud: https://<ref>.supabase.co/storage/v1 (credential still an open decision, see README).
STORAGE_URL=http://localhost:54324
STORAGE_TOKEN=
# STORAGE_API_KEY=            # cloud only: the project's publishable key

# ---------- Supabase project (public client values; used by web in step 12) ----------
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_PROJECT_REF=
# SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------- added in later steps (listed so nothing is a surprise) ----------
# Step 6  CREDENTIALS_PUBLIC_KEY (api), CREDENTIALS_PRIVATE_KEY_FILE (worker only)
# Step 10 TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, TELEGRAM_CALLBACK_HMAC_KEY,
#         ADMIN_TELEGRAM_CHAT_ID, ADMIN_EMAIL, PUBLIC_APP_URL
# Step 13 SYSTEM_SMTP_* (system sender for owner/admin notifications)
