# Copy to .env for local development. Never commit real values.
# Variables are grouped by the process that reads them; each process only
# receives its own group in production (see docker/compose.prod.yml, step 15).

# ---------- shared ----------
NODE_ENV=development
LOG_LEVEL=info

# ---------- migrations (schema owner; CI / deploy only, never at runtime) ----------
# Local: the docker/compose.dev.yml database.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# ---------- api ----------
API_HOST=0.0.0.0
API_PORT=4000
# Runtime role noctiv_api (RLS enforced). Password is set outside migrations:
#   alter role noctiv_api with login password '...';
# Supabase session pooler format: postgres://noctiv_api.<project-ref>:<pw>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
API_DATABASE_URL=postgres://noctiv_api:change-me@localhost:54322/postgres

# ---------- worker ----------
# Runtime role noctiv_worker (RLS enforced).
WORKER_DATABASE_URL=postgres://noctiv_worker:change-me@localhost:54322/postgres

# ---------- tests ----------
# Optional: reuse a running database instead of starting a container.
# Must be a disposable database; tests create and drop data freely.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# ---------- added in later steps (listed so nothing is a surprise) ----------
# Step 4  GCP_PROJECT_ID, GCP_LOCATION=europe-west4, GOOGLE_APPLICATION_CREDENTIALS,
#         LLM_MODEL_FAST, LLM_MODEL_QUALITY, EMBED_MODEL, DEFAULT_DAILY_TOKEN_BUDGET
# Step 5  SUPABASE_URL, SUPABASE_STORAGE_BUCKET
# Step 6  CREDENTIALS_PUBLIC_KEY (api), CREDENTIALS_PRIVATE_KEY_FILE (worker only)
# Step 10 TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET, TELEGRAM_CALLBACK_HMAC_KEY,
#         ADMIN_TELEGRAM_CHAT_ID, ADMIN_EMAIL, PUBLIC_APP_URL
# Step 13 SYSTEM_SMTP_* (system sender for owner/admin notifications)
